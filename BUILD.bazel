load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

# Gazelle writes the BUILD files from the Go sources; these directives are the
# only hand-written part.
#
# The generated Go in protobuf/generated/go is committed, so no proto rules:
# the .proto files are buf's input, not Bazel's.
# gazelle:prefix github.com/shokki-engineering/aperio
# gazelle:proto disable_global
# gazelle:go_naming_convention import
# gazelle:exclude deploy/hasura
# gazelle:exclude protobuf/generated/prisma
# gazelle:exclude test/load
# gazelle:exclude .claude
# gazelle:exclude .cache
gazelle(name = "gazelle")

go_library(
    name = "aperio_lib",
    srcs = [
        "app.go",
        "build.go",
        "main.go",
    ],
    importpath = "github.com/shokki-engineering/aperio",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/server",
        "//internal/telemetry",
        "@com_github_joho_godotenv//autoload",
        "@com_github_the_protobuf_project_runtime_go_grpc//:grpc",
        "@org_golang_x_crypto_x509roots_fallback//:fallback",
    ],
)

go_binary(
    name = "aperio",
    embed = [":aperio_lib"],
    # No symbol table or DWARF, as the Dockerfile's -ldflags "-s -w" built it.
    # Gazelle manages gc_linkopts; keep says these are not its to remove.
    gc_linkopts = [
        "-s",
        "-w",
    ],  # keep
    visibility = ["//visibility:public"],
    # Filled only when stamping (bazel build --config=release); see build.go.
    x_defs = {
        "buildVersion": "{STABLE_BUILD_VERSION}",
        "buildCommit": "{STABLE_BUILD_COMMIT}",
    },
)

# The generated Prisma package as the migrate image carries it: the schema,
# migrations/ and aperio.config.ts. No BUILD file of its own: `just gen
# prisma` empties that directory, so it is named from here. Left out, as the
# Dockerfile's .dockerignore left them out: node_modules and .env files.
filegroup(
    name = "prisma",
    srcs = glob(
        ["protobuf/generated/prisma/aperio/**"],
        allow_empty = False,
        exclude = [
            "protobuf/generated/prisma/aperio/node_modules/**",
            "protobuf/generated/prisma/aperio/.env",
            "protobuf/generated/prisma/aperio/.env.*",
        ],
    ) + ["protobuf/generated/prisma/aperio/.env.example"],
    visibility = ["//deploy/image:__pkg__"],
)
