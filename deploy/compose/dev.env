# The development database's settings (`just db up`, `just db reset`): the
# values internal/config/aperio.dev.toml connects with. Not secrets -- local
# only. Compose wants every required variable even for one service, so the
# others have placeholders; the stack itself reads .env (.env.example).
POSTGRES_PASSWORD=postgrespassword
APERIO_POSTGRES_PORT=5433
FREEBUSY_POSTGRES_PASSWORD=unused
WEBHOOK_SECRET_KEY=unused
APERIO_HOLD_SECRET=unused
APERIO_LINK_SECRET=unused
