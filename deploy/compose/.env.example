# The Compose stack's settings: copy to .env, which is never committed, and
# replace every CHANGE_ME. Any other aperio setting can be added to the aperio
# service as APERIO_<SECTION>__<KEY> (internal/config/aperio.release.toml).

# The releases to run, pulled when missing; `just image` builds aperio's from
# this checkout (Bazel) as :latest.
APERIO_TAG=latest
APERIO_IMAGE=ghcr.io/shokki-engineering/aperio
APERIO_MIGRATE_IMAGE=ghcr.io/shokki-engineering/aperio-migrate
APERIO_ENGINE_IMAGE=ghcr.io/shokki-engineering/aperio-engine
APERIO_CONNECTOR_IMAGE=ghcr.io/shokki-engineering/aperio-connector
FREEBUSY_TAG=latest
FREEBUSY_IMAGE=ghcr.io/shokki-engineering/freebusy
FREEBUSY_MIGRATIONS_IMAGE=ghcr.io/shokki-engineering/freebusy-migrations
FREEBUSY_ENGINE_IMAGE=ghcr.io/shokki-engineering/freebusy-engine
FREEBUSY_CONNECTOR_IMAGE=ghcr.io/shokki-engineering/freebusy-connector

# Secrets. openssl rand -base64 24 for the passwords, openssl rand -hex 32
# for the rest. POSTGRES_PASSWORD only takes effect when aperio's volume is
# first made: the dev database (`just db up`) was made with postgrespassword.
POSTGRES_PASSWORD=CHANGE_ME
FREEBUSY_POSTGRES_PASSWORD=CHANGE_ME
# Seals freebusy's webhook signing secrets at rest. Keep it.
WEBHOOK_SECRET_KEY=CHANGE_ME
# Seals the concierge's hold tokens.
APERIO_HOLD_SECRET=CHANGE_ME
# Signs guests' links to a quote, reservation or invoice.
APERIO_LINK_SECRET=CHANGE_ME
# Signs freebusy's .ics feed links; aperio hands them out. Empty: no feeds.
FEEDS_SECRET=
# Where calendar apps reach freebusy's feeds.
FREEBUSY_PUBLIC_URL=http://localhost:8080

# Staff sign-in: the OIDC issuer and the client ID its tokens are issued to.
# Empty, auth is OFF and every call is let through.
APERIO_AUTH_ISSUER=
APERIO_AUTH_AUDIENCE=
# The guest site guests' share links open; unset, http://localhost:3000.
APERIO_LINK_BASE_URL=

# Host ports, all on 127.0.0.1.
APERIO_GRPC_PORT=50061
APERIO_HTTP_PORT=8090
APERIO_MCP_PORT=8091
APERIO_POSTGRES_PORT=5433
FREEBUSY_GRPC_PORT=50051
FREEBUSY_HTTP_PORT=8080
FREEBUSY_MCP_PORT=8081
APERIO_ENGINE_PORT=3281
FREEBUSY_ENGINE_PORT=3280
OPENSEARCH_PORT=9200

# gorm (Postgres, the default) or hasura (with the hasura profile).
APERIO_DATABASE_PROVIDER=gorm
FREEBUSY_DATABASE_PROVIDER=gorm
# The connectors' tokens: the committed engine builds embed these values.
APERIO_CONNECTOR_TOKEN=aperio-local-connector
FREEBUSY_CONNECTOR_TOKEN=freebusy-local-connector

# A frontend on another origin calling aperio's REST gateway. Origins are
# exact (scheme://host[:port]) and comma-separated, or "*" (not with
# credentials).
APERIO_CORS_ENABLED=true
APERIO_CORS_ALLOWED_ORIGINS=http://localhost:5173
APERIO_CORS_ALLOW_CREDENTIALS=false

# The cache profile's Redis, shared by both (their keys are prefixed).
APERIO_CACHE_ENABLED=false
FREEBUSY_CACHE_ENABLED=false
REDIS_PASSWORD=CHANGE_ME

# GET /metrics on aperio's REST port, for Prometheus.
APERIO_METRICS=true

# freebusy's webhook to aperio ([freebusy_sync]): where freebusy POSTs its
# changes (inside the stack: http://aperio:8090/webhooks/freebusy; empty,
# the reconciler alone keeps aperio in step), and the subscription's whsec_ signing secret
# (empty: freebusy mints one on each start, and the server says so).
APERIO_FREEBUSY_WEBHOOK_URL=
APERIO_FREEBUSY_WEBHOOK_SECRET=

# Booking.com ([channels.bookingcom]): its hotels as one JSON array,
# [{"hotel_code":"7777001","venue":"venues/<id>","rooms":[{"code":"SV-DLX","space":"venues/<id>/spaces/<id>","rate_plan":"BAR"}]}]
APERIO_BOOKINGCOM_ENABLED=false
APERIO_BOOKINGCOM_HOTELS_JSON=

# The search profile's OpenSearch: "opensearch" searches it, falling back to
# Postgres; "postgres" (default) searches the read models' tables.
APERIO_SEARCH_PROVIDER=postgres
FREEBUSY_SEARCH_PROVIDER=postgres
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# An OTLP collector, host:port (gRPC); empty exports nothing. The engines
# want a URL: http://host:port.
OTLP_ENDPOINT=
ENGINE_OTLP_ENDPOINT=
# The connectors' collector URL. Leave it commented out for none: set but
# empty, it stops them.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host:4317
TELEMETRY_ENVIRONMENT=production
# Labels this deployment's telemetry, e.g. riverside-club.
SITE=
