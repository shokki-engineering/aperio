# aperio's two images, both linux/amd64 + linux/arm64 indexes.
#
# The server (:image): the static binary and nothing else -- no base image,
# no shell, no libc, no certificate store. The binary carries what an empty
# filesystem lacks (the time zone database and fallback root certificates,
# main.go) and is configured entirely by APERIO_<SECTION>__<KEY> variables
# over the release defaults compiled into it (internal/config).
#
#   bazel run //deploy/image:load              # ghcr.io/shokki-engineering/aperio:latest
#   bazel run //deploy/image:push -- --tag <tag>
#
# The migrations (:migrate): the Prisma CLI, its schema engine and
# protobuf/generated/prisma/aperio, on distroless Node. `prisma migrate
# deploy` against APERIO_DATABASE_URL, applying only what the database has
# not seen, then exiting: how a deployment with no checkout -- the Compose
# stack, the Helm chart's pre-install Job -- runs `just db deploy`.
#
#   bazel run //deploy/image:load_migrate      # ghcr.io/shokki-engineering/aperio-migrate:latest
#   bazel run //deploy/image:push_migrate -- --tag <tag>
#
# A release stamps the binary and the version and revision labels:
# --config=release (.bazelrc, tools/bazel/status.sh).
load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")
load("@rules_go//go:def.bzl", "go_cross_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

ARCHS = [
    "amd64",
    "arm64",
]

# The OCI base each migrate image is built on (MODULE.bazel's oci.pull).
NODE = {
    "amd64": "@node_linux_amd64",
    "arm64": "@node_linux_arm64_v8",
}

# Each image's labels, the version and revision stamped by a release.
[expand_template(
    name = name + "_labels",
    out = name + "_labels.txt",
    stamp_substitutions = {
        "version=dev": "version={{STABLE_IMAGE_VERSION}}",
        "revision=dev": "revision={{STABLE_BUILD_COMMIT}}",
    },
    template = [
        "org.opencontainers.image.title=" + title,
        "org.opencontainers.image.description=" + description,
        "org.opencontainers.image.source=https://github.com/shokki-engineering/aperio",
        "org.opencontainers.image.licenses=AGPL-3.0-or-later",
        "org.opencontainers.image.version=dev",
        "org.opencontainers.image.revision=dev",
    ],
) for name, title, description in [
    ("image", "aperio", "Venue backend: stays, events, leads, quotes, GST invoices and payments, booked through freebusy."),
    ("migrate", "aperio-migrate", "The aperio database's Prisma migrations, applied with prisma migrate deploy."),
]]

# The server.

[go_cross_binary(
    name = "aperio_linux_" + arch,
    platform = "@rules_go//go/toolchain:linux_" + arch,
    target = "//:aperio",
) for arch in ARCHS]

[pkg_tar(
    name = "layer_" + arch,
    files = {":aperio_linux_" + arch: "aperio"},
    mode = "0755",
) for arch in ARCHS]

[oci_image(
    name = "image_" + arch,
    architecture = arch,
    entrypoint = ["/aperio"],
    # gRPC, HTTP (REST and /health), MCP (/mcp).
    exposed_ports = [
        "50061/tcp",
        "8090/tcp",
        "8091/tcp",
    ],
    labels = ":image_labels",
    os = "linux",
    tars = [":layer_" + arch],
    # Not root: the image has no users, so a bare uid:gid.
    user = "65532:65532",
) for arch in ARCHS]

oci_image_index(
    name = "image",
    images = [":image_" + arch for arch in ARCHS],
    visibility = ["//visibility:public"],
)

# Docker loads one platform: the machine's own.
oci_load(
    name = "load",
    image = select({
        "@platforms//cpu:arm64": ":image_arm64",
        "//conditions:default": ":image_amd64",
    }),
    repo_tags = ["ghcr.io/shokki-engineering/aperio:latest"],
)

oci_push(
    name = "push",
    image = ":image",
    repository = "ghcr.io/shokki-engineering/aperio",
)

# The migrations.

# The generated Prisma package at /prisma, beside node_modules.
pkg_tar(
    name = "migrate_schema",
    srcs = ["//:prisma"],
    mode = "0644",
    package_dir = "/prisma",
    strip_prefix = "/protobuf/generated/prisma/aperio",
)

[pkg_tar(
    name = "migrate_engine_" + arch,
    files = {"@prisma_engine_" + arch + "//:schema-engine": "schema-engine"},
    mode = "0755",
    package_dir = "/prisma/engines",
) for arch in ARCHS]

[oci_image(
    name = "migrate_" + arch,
    base = NODE[arch],
    # The database is APERIO_DATABASE_URL:
    # postgresql://user:password@host:5432/aperio.
    entrypoint = [
        "/nodejs/bin/node",
        "/prisma/node_modules/prisma/build/index.js",
        "migrate",
        "deploy",
        "--config",
        "aperio.config.ts",
    ],
    env = {
        "CHECKPOINT_DISABLE": "1",
        "NODE_ENV": "production",
        "PRISMA_HIDE_UPDATE_MESSAGE": "1",
        # The engine @prisma/engines' install script would have downloaded;
        # with no shell in the image, Prisma could not detect the platform
        # to find it by name.
        "PRISMA_SCHEMA_ENGINE_BINARY": "/prisma/engines/schema-engine",
    },
    labels = ":migrate_labels",
    tars = [
        "@prisma_cli//:layer",
        ":migrate_engine_" + arch,
        ":migrate_schema",
    ],
    user = "65532:65532",
    workdir = "/prisma",
) for arch in ARCHS]

oci_image_index(
    name = "migrate",
    images = [":migrate_" + arch for arch in ARCHS],
)

oci_load(
    name = "load_migrate",
    image = select({
        "@platforms//cpu:arm64": ":migrate_arm64",
        "//conditions:default": ":migrate_amd64",
    }),
    repo_tags = ["ghcr.io/shokki-engineering/aperio-migrate:latest"],
)

oci_push(
    name = "push_migrate",
    image = ":migrate",
    repository = "ghcr.io/shokki-engineering/aperio-migrate",
)
