# The connector's settings for local development and CI: copy to .env.
#
# The token is not a secret. The connector listens only inside the local
# Docker network, and the committed engine build (engine/build) embeds this
# same value -- which is what lets CI run the engine without a Hasura login.
# Rebuild with `just hasura regen` after changing anything below.
APERIO_APERIO_PGSQL_CONNECTION_URI="postgresql://postgres:postgrespassword@local.hasura.dev:5433/aperio"
APERIO_APERIO_PGSQL_HASURA_CONNECTOR_PORT=9795
APERIO_APERIO_PGSQL_READ_URL="http://local.hasura.dev:9795"
APERIO_APERIO_PGSQL_WRITE_URL="http://local.hasura.dev:9795"
APERIO_APERIO_PGSQL_HASURA_SERVICE_TOKEN_SECRET="aperio-local-connector"
APERIO_APERIO_PGSQL_AUTHORIZATION_HEADER="Bearer aperio-local-connector"
APERIO_APERIO_PGSQL_OTEL_EXPORTER_OTLP_ENDPOINT="http://local.hasura.dev:6009"
APERIO_APERIO_PGSQL_OTEL_SERVICE_NAME="aperio_aperio_pgsql"
