kind: ObjectType
version: v1
definition:
  name: UpdateProfileTrainPrefsByIdUpdateColumns
  description: Update the columns of the 'profile_train_prefs' collection
  fields:
    - name: directAndNonStopOnly
      type: UpdateColumnProfileTrainPrefsDirectAndNonStopOnly
      description: Update the 'direct_and_non_stop_only' column in the
        'profile_train_prefs' collection.
    - name: id
      type: UpdateColumnProfileTrainPrefsId
      description: Update the 'id' column in the 'profile_train_prefs' collection.
    - name: maxConnections
      type: UpdateColumnProfileTrainPrefsMaxConnections
      description: Update the 'max_connections' column in the 'profile_train_prefs'
        collection.
    - name: nonStopsOnly
      type: UpdateColumnProfileTrainPrefsNonStopsOnly
      description: Update the 'non_stops_only' column in the 'profile_train_prefs'
        collection.
    - name: preferLevel
      type: UpdateColumnProfileTrainPrefsPreferLevel
      description: Update the 'prefer_level' column in the 'profile_train_prefs' collection.
    - name: railPrefId
      type: UpdateColumnProfileTrainPrefsRailPrefId
      description: Update the 'rail_pref_id' column in the 'profile_train_prefs' collection.
    - name: routingType
      type: UpdateColumnProfileTrainPrefsRoutingType
      description: Update the 'routing_type' column in the 'profile_train_prefs' collection.
    - name: sameOperatorOnly
      type: UpdateColumnProfileTrainPrefsSameOperatorOnly
      description: Update the 'same_operator_only' column in the 'profile_train_prefs'
        collection.
    - name: trainType
      type: UpdateColumnProfileTrainPrefsTrainType
      description: Update the 'train_type' column in the 'profile_train_prefs' collection.
  graphql:
    typeName: UpdateProfileTrainPrefsByIdUpdateColumns
    inputTypeName: UpdateProfileTrainPrefsByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: aperio_pgsql
      dataConnectorObjectType: update_profile_train_prefs_by_id_update_columns
      fieldMapping:
        directAndNonStopOnly:
          column:
            name: direct_and_non_stop_only
        id:
          column:
            name: id
        maxConnections:
          column:
            name: max_connections
        nonStopsOnly:
          column:
            name: non_stops_only
        preferLevel:
          column:
            name: prefer_level
        railPrefId:
          column:
            name: rail_pref_id
        routingType:
          column:
            name: routing_type
        sameOperatorOnly:
          column:
            name: same_operator_only
        trainType:
          column:
            name: train_type

