      dataConnectorObjectType: hotel_languages
      fieldMapping:
        hotelInfoId:
          column:
            name: hotel_info_id
        id:
          column:
            name: id
        languageCode:
          column:
            name: language_code
        primaryLang:
          column:
            name: primary_lang

