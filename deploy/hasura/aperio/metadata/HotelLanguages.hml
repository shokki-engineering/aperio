---
kind: ObjectType
version: v1
definition:
  name: HotelLanguages
  fields:
    - name: hotelInfoId
      type: String_1!
    - name: id
      type: String_1!
    - name: languageCode
      type: String_1
    - name: primaryLang
      type: Boolean_1
  graphql:
    typeName: HotelLanguages
    inputTypeName: HotelLanguagesInput
  dataConnectorTypeMapping:
