    - name: createDateTime
      type: UpdateColumnEventParagraphsCreateDateTime
      description: Update the 'create_date_time' column in the 'event_paragraphs'
        collection.
    - name: creatorId
      type: UpdateColumnEventParagraphsCreatorId
      description: Update the 'creator_id' column in the 'event_paragraphs' collection.
    - name: displayName
      type: UpdateColumnEventParagraphsDisplayName
      description: Update the 'display_name' column in the 'event_paragraphs' collection.
    - name: eventDayFunctionId
      type: UpdateColumnEventParagraphsEventDayFunctionId
      description: Update the 'event_day_function_id' column in the 'event_paragraphs'
        collection.
    - name: eventId
      type: UpdateColumnEventParagraphsEventId
      description: Update the 'event_id' column in the 'event_paragraphs' collection.
    - name: eventInfoId
      type: UpdateColumnEventParagraphsEventInfoId
      description: Update the 'event_info_id' column in the 'event_paragraphs' collection.
    - name: exhibitionId
      type: UpdateColumnEventParagraphsExhibitionId
      description: Update the 'exhibition_id' column in the 'event_paragraphs' collection.
