  description: Update the columns of the 'event_paragraphs' collection
  fields:
    - name: attendeeInfoId
      type: UpdateColumnEventParagraphsAttendeeInfoId
      description: Update the 'attendee_info_id' column in the 'event_paragraphs'
        collection.
    - name: audioVisualId
