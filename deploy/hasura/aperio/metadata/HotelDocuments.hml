---
kind: ObjectType
version: v1
definition:
  name: HotelDocuments
  fields:
    - name: docId
      type: String_1
    - name: docType
      type: Enum
    - name: id
      type: String_1!
  graphql:
    typeName: HotelDocuments
    inputTypeName: HotelDocumentsInput
  dataConnectorTypeMapping:
    - dataConnectorName: aperio_pgsql
      dataConnectorObjectType: hotel_documents
      fieldMapping:
        docId:
          column:
            name: doc_id
        docType:
          column:
            name: doc_type
        id:
          column:
            name: id

---
kind: TypePermissions
version: v1
definition:
  typeName: HotelDocuments
  permissions:
    - role: admin
      output:
        allowedFields:
          - docId
          - docType
          - id

---
kind: BooleanExpressionType
version: v1
definition:
  name: HotelDocumentsBoolExp
  operand:
    object:
      type: HotelDocuments
      comparableFields:
        - fieldName: docId
          booleanExpressionType: TextBoolExp
        - fieldName: docType
          booleanExpressionType: HotelHotelDocumentTypeBoolExp
        - fieldName: id
          booleanExpressionType: TextBoolExp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: HotelDocumentsBoolExp

---
kind: AggregateExpression
version: v1
definition:
  name: HotelDocumentsAggExp
  operand:
    object:
      aggregatedType: HotelDocuments
      aggregatableFields:
        - fieldName: docId
          aggregateExpression: TextAggExp
        - fieldName: docType
          aggregateExpression: HotelHotelDocumentTypeAggExp
        - fieldName: id
          aggregateExpression: TextAggExp
  count:
    enable: true
    returnType: Int64
  graphql:
    selectTypeName: HotelDocumentsAggExp

---
kind: OrderByExpression
version: v1
definition:
  name: HotelDocumentsOrderByExp
  operand:
    object:
      orderedType: HotelDocuments
      orderableFields:
        - fieldName: docId
          orderByExpression: String1OrderByExp
        - fieldName: docType
          orderByExpression: EnumOrderByExp
        - fieldName: id
          orderByExpression: String1OrderByExp
      orderableRelationships: []
  graphql:
    expressionTypeName: HotelDocumentsOrderByExp

---
kind: Model
version: v2
definition:
  name: HotelDocuments
  objectType: HotelDocuments
  source:
    dataConnectorName: aperio_pgsql
    collection: hotel_documents
  filterExpressionType: HotelDocumentsBoolExp
  aggregateExpression: HotelDocumentsAggExp
  orderByExpression: HotelDocumentsOrderByExp
  graphql:
    selectMany:
      queryRootField: hotelDocuments
      subscription:
        rootField: hotelDocuments
    selectUniques:
      - queryRootField: hotelDocumentsById
        uniqueIdentifier:
          - id
        subscription:
          rootField: hotelDocumentsById
    filterInputTypeName: HotelDocumentsFilterInput
    aggregate:
