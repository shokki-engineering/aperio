kind: DataConnectorLink
version: v1
definition:
  name: aperio_pgsql
  url:
    readWriteUrls:
      read:
        valueFromEnv: APERIO_APERIO_PGSQL_READ_URL
      write:
        valueFromEnv: APERIO_APERIO_PGSQL_WRITE_URL
  headers:
    Authorization:
      valueFromEnv: APERIO_APERIO_PGSQL_AUTHORIZATION_HEADER
  schema:
    version: v0.2
    schema:
      capabilities:
        query:
          aggregates:
            count_scalar_type: int8
      collections:
        - arguments: {}
          name: _prisma_migrations
          type: _prisma_migrations
          uniqueness_constraints:
            _prisma_migrations_pkey:
