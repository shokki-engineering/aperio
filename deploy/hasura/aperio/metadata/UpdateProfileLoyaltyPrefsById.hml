      description: Update the 'hotel_pref_id' column in the 'profile_loyalty_prefs'
        collection.
    - name: id
      type: UpdateColumnProfileLoyaltyPrefsId
      description: Update the 'id' column in the 'profile_loyalty_prefs' collection.
    - name: otherSrvcPrefId
      type: UpdateColumnProfileLoyaltyPrefsOtherSrvcPrefId
      description: Update the 'other_srvc_pref_id' column in the
        'profile_loyalty_prefs' collection.
    - name: preferLevel
      type: UpdateColumnProfileLoyaltyPrefsPreferLevel
      description: Update the 'prefer_level' column in the 'profile_loyalty_prefs'
        collection.
    - name: railPrefId
      type: UpdateColumnProfileLoyaltyPrefsRailPrefId
      description: Update the 'rail_pref_id' column in the 'profile_loyalty_prefs'
        collection.
    - name: rph
      type: UpdateColumnProfileLoyaltyPrefsRph
      description: Update the 'rph' column in the 'profile_loyalty_prefs' collection.
    - name: value
      type: UpdateColumnProfileLoyaltyPrefsValue
      description: Update the 'value' column in the 'profile_loyalty_prefs' collection.
  graphql:
    typeName: UpdateProfileLoyaltyPrefsByIdUpdateColumns
    inputTypeName: UpdateProfileLoyaltyPrefsByIdUpdateColumnsInput
  dataConnectorTypeMapping:
    - dataConnectorName: aperio_pgsql
      dataConnectorObjectType: update_profile_loyalty_prefs_by_id_update_columns
      fieldMapping:
        airlinePrefId:
          column:
            name: airline_pref_id
        commonPrefId:
          column:
            name: common_pref_id
        hotelPrefId:
          column:
            name: hotel_pref_id
        id:
          column:
            name: id
        otherSrvcPrefId:
          column:
            name: other_srvc_pref_id
        preferLevel:
          column:
            name: prefer_level
        railPrefId:
          column:
            name: rail_pref_id
        rph:
          column:
            name: rph
        value:
