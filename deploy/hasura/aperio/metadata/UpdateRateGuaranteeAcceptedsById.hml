kind: ObjectType
version: v1
definition:
  name: UpdateRateGuaranteeAcceptedsByIdUpdateColumns
  description: Update the columns of the 'rate_guarantee_accepteds' collection
  fields:
    - name: addressReq
      type: UpdateColumnRateGuaranteeAcceptedsAddressReq
      description: Update the 'address_req' column in the 'rate_guarantee_accepteds'
        collection.
    - name: bankAcctId
      type: UpdateColumnRateGuaranteeAcceptedsBankAcctId
      description: Update the 'bank_acct_id' column in the 'rate_guarantee_accepteds'
        collection.
    - name: bookingSourceAllowed
      type: UpdateColumnRateGuaranteeAcceptedsBookingSourceAllowed
      description: Update the 'booking_source_allowed' column in the
        'rate_guarantee_accepteds' collection.
    - name: cashId
      type: UpdateColumnRateGuaranteeAcceptedsCashId
      description: Update the 'cash_id' column in the 'rate_guarantee_accepteds' collection.
    - name: corpDiscountNbrAllowed
      type: UpdateColumnRateGuaranteeAcceptedsCorpDiscountNbrAllowed
      description: Update the 'corp_discount_nbr_allowed' column in the
        'rate_guarantee_accepteds' collection.
    - name: costCenterId
      type: UpdateColumnRateGuaranteeAcceptedsCostCenterId
      description: Update the 'cost_center_id' column in the
        'rate_guarantee_accepteds' collection.
    - name: defaultValue
      type: UpdateColumnRateGuaranteeAcceptedsDefaultValue
      description: Update the 'default_value' column in the 'rate_guarantee_accepteds'
        collection.
    - name: directBillId
      type: UpdateColumnRateGuaranteeAcceptedsDirectBillId
      description: Update the 'direct_bill_id' column in the
        'rate_guarantee_accepteds' collection.
    - name: guaranteeId
      type: UpdateColumnRateGuaranteeAcceptedsGuaranteeId
      description: Update the 'guarantee_id' column in the 'rate_guarantee_accepteds'
