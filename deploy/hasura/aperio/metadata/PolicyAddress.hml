      type: String_1
    - name: countryDisplayNameId
      type: String_1
    - name: county
      type: String_1
    - name: formatted
      type: Boolean_1
    - name: id
      type: String_1!
    - name: languageCode
      type: String_1
    - name: postalCode
      type: String_1
    - name: remark
      type: String_1
    - name: shareMarketInd
      type: Enum
    - name: shareSynchInd
      type: Enum
    - name: stateProvId
      type: String_1
    - name: streetNmbrId
      type: String_1
    - name: type
      type: Enum
    - name: valid
      type: Boolean_1
  graphql:
    typeName: PolicyAddress
    inputTypeName: PolicyAddressInput
  dataConnectorTypeMapping:
    - dataConnectorName: aperio_pgsql
      dataConnectorObjectType: policy_address
      fieldMapping:
        addressLines:
          column:
            name: address_lines
        cityDisplayName:
          column:
            name: city_display_name
        countryDisplayNameId:
          column:
            name: country_display_name_id
        county:
          column:
            name: county
        formatted:
          column:
            name: formatted
        id:
          column:
            name: id
        languageCode:
          column:
            name: language_code
        postalCode:
          column:
            name: postal_code
        remark:
          column:
            name: remark
        shareMarketInd:
          column:
            name: share_market_ind
        shareSynchInd:
          column:
            name: share_synch_ind
        stateProvId:
          column:
            name: state_prov_id
        streetNmbrId:
          column:
            name: street_nmbr_id
        type:
          column:
            name: type
        valid:
          column:
            name: valid

---
kind: TypePermissions
version: v1
definition:
  typeName: PolicyAddress
  permissions:
    - role: admin
      output:
        allowedFields:
          - addressLines
          - cityDisplayName
          - countryDisplayNameId
          - county
          - formatted
          - id
          - languageCode
          - postalCode
          - remark
          - shareMarketInd
          - shareSynchInd
          - stateProvId
          - streetNmbrId
          - type
          - valid

---
kind: BooleanExpressionType
version: v1
definition:
  name: PolicyAddressBoolExp
  operand:
    object:
      type: PolicyAddress
      comparableFields:
        - fieldName: cityDisplayName
          booleanExpressionType: TextBoolExp
        - fieldName: countryDisplayNameId
          booleanExpressionType: TextBoolExp
        - fieldName: county
          booleanExpressionType: TextBoolExp
        - fieldName: formatted
          booleanExpressionType: BoolBoolExp
        - fieldName: id
          booleanExpressionType: TextBoolExp
        - fieldName: languageCode
          booleanExpressionType: TextBoolExp
        - fieldName: postalCode
          booleanExpressionType: TextBoolExp
        - fieldName: remark
          booleanExpressionType: TextBoolExp
        - fieldName: shareMarketInd
          booleanExpressionType: PolicyPolicyAcceptedPaymentShareMarketIndBoolExp
        - fieldName: shareSynchInd
          booleanExpressionType: PolicyPolicyAcceptedPaymentShareSynchIndBoolExp
        - fieldName: stateProvId
          booleanExpressionType: TextBoolExp
        - fieldName: streetNmbrId
          booleanExpressionType: TextBoolExp
        - fieldName: type
          booleanExpressionType: PolicyPolicyCommunicationLocationTypeBoolExp
        - fieldName: valid
          booleanExpressionType: BoolBoolExp
      comparableRelationships: []
  logicalOperators:
    enable: true
  isNull:
    enable: true
  graphql:
    typeName: PolicyAddressBoolExp

---
kind: AggregateExpression
version: v1
definition:
  name: PolicyAddressAggExp
  operand:
    object:
      aggregatedType: PolicyAddress
      aggregatableFields:
        - fieldName: cityDisplayName
          aggregateExpression: TextAggExp
