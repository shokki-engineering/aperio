        - fieldName: shareMarketInd
          aggregateExpression: PolicyPolicyAcceptedPaymentShareMarketIndAggExp
        - fieldName: shareSynchInd
          aggregateExpression: PolicyPolicyAcceptedPaymentShareSynchIndAggExp
        - fieldName: stateProvId
          aggregateExpression: TextAggExp
        - fieldName: streetNmbrId
          aggregateExpression: TextAggExp
        - fieldName: type
          aggregateExpression: PolicyPolicyCommunicationLocationTypeAggExp
        - fieldName: valid
          aggregateExpression: BoolAggExp
  count:
    enable: true
