---
kind: Model
version: v2
definition:
  name: PolicyAddress
  objectType: PolicyAddress
  source:
    dataConnectorName: aperio_pgsql
    collection: policy_address
  filterExpressionType: PolicyAddressBoolExp
  aggregateExpression: PolicyAddressAggExp
  orderByExpression: PolicyAddressOrderByExp
  graphql:
    selectMany:
      queryRootField: policyAddress
      subscription:
        rootField: policyAddress
    selectUniques:
      - queryRootField: policyAddressById
        uniqueIdentifier:
          - id
        subscription:
          rootField: policyAddressById
    filterInputTypeName: PolicyAddressFilterInput
    aggregate:
      queryRootField: policyAddressAggregate
      subscription:
        rootField: policyAddressAggregate

