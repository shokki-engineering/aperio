/// Attributes to describe the room from room category to location to view to bed type.
model RoomtypeRoom {
  /// Unique identifier for the record.
  id String @id(map: "roomtype_rooms_pkey") @default(ulid()) @map("id")

  /// (Formerly, RoomInventoryCode) A code value that indicates the type of room for which this request is made, e.g.: double, king, etc. Values may use the Hotel Descriptive Content table or a codes specific to the property or hotel brand. OTA: RoomGroup/@RoomType.
  roomType String? @map("room_type")

  /// Specific system room type code, ex: A1K, A1Q etc. OTA: RoomGroup/@RoomTypeCode.
  roomTypeCode String? @map("room_type_code")

  /// Indicates the category of the room. Typical values would be Moderate, Standard, or Deluxe. Refer to OpenTravel Code List Segment Category Code (SEG). Codes from the OpenTravel code table SEG; each value's number is its OTA code. OTA: RoomGroup/@RoomCategory.
  roomCategory RoomtypeSegmentCategoryCode? @map("room_category")

  /// A string value representing the unique identification of a room if the request is looking for a specific room. OTA: RoomGroup/@RoomID.
  roomID String? @map("room_id")

  /// Floor on which the room is located. OTA: RoomGroup/@Floor.
  floor Int? @map("floor")

  /// A code or identification number that identifies the room stay as part of a group, package tour, or block of rooms designated in the inventory. OTA: RoomGroup/@InvBlockCode.
  invBlockCode String? @map("inv_block_code")

  /// Promotion code is the identifier used by the host to link directly with a specific named advertising campaign. By including the required code, the client is able to gain access to special offers which may have been created for a specifically targeted group via a CRM system or for a wider advertising campaign using Television or press adverts. OTA: RoomGroup/@PromotionCode.
  promotionCode String? @map("promotion_code")

  /// List of the vendor codes associated with a promotion. OTA: RoomGroup/@PromotionVendorCode.
  promotionVendorCodes String[] @map("promotion_vendor_codes")

  /// Indicates the location of the room within the hotel structure. Typical values would be "Near Exit","Close to elevator", "Low Floor" or "High Floor". Refer to OpenTravel Code List Room Location Type (RLT). Codes from the OpenTravel code table RLT; each value's number is its OTA code. OTA: RoomGroup/@RoomLocationCode.
  roomLocationCode RoomtypeRoomLocationType? @map("room_location_code")

  /// Indicates the view of the room. Typical values would be "Ocean view", "Pool view" or "Garden View". Refer to OpenTravel Code List Room View Type (RVT). Codes from the OpenTravel code table RVT; each value's number is its OTA code. OTA: RoomGroup/@RoomViewCode.
  roomViewCode RoomtypeRoomViewType? @map("room_view_code")

  /// Indicates the type of bed(s) found in the room. Typical values would be Double, Twin, Queen, or King. Refer to OpenTravel Code List Bed Type Code (BED). Codes from the OpenTravel code table BED; each value's number is its OTA code. OTA: RoomGroup/@BedTypeCode.
  bedTypeCodes String? @map("bed_type_codes")

  /// Non-smoking indicator. OTA: RoomGroup/@NonSmoking.
  nonSmoking Boolean? @map("non_smoking")

  /// Textual description of room configuration. OTA: RoomGroup/@Configuration.
  config String? @map("config")

  /// Textual description of room dimensions. OTA: RoomGroup/@SizeMeasurement.
  sizeMeasurement String? @map("size_measurement")

  /// Defines the number of the item in question. OTA: RoomGroup/@Quantity.
  quantity Int? @map("quantity")

  /// Indicates that the room (suite) is a composite of smaller units. OTA: RoomGroup/@Composite.
  composite Boolean? @map("composite")

  /// Specifies the room classification (e.g., cabin, apartment). Refer to OpenTravel Code List Guest Room Info (GRI). Codes from the OpenTravel code table GRI; each value's number is its OTA code. OTA: RoomGroup/@RoomClassificationCode.
  roomClassificationCode RoomtypeGuestRoomInfo? @map("room_classification_code")

  /// Specifies the architectural style of a room. Refer to OpenTravel Code List Architectural Style Code (ARC). Codes from the OpenTravel code table ARC; each value's number is its OTA code. OTA: RoomGroup/@RoomArchitectureCode.
  roomArchitectureCode RoomtypeArchitecturalStyleCode? @map("room_architecture_code")

  /// Used to request or specify a gender assignment for a room. Note: Typically used by Hosteliers. OTA: RoomGroup/@RoomGender.
  roomGender RoomtypeRoomGender? @map("room_gender")

  /// If TRUE, the room requires or has sharing available. Note: Typically used by Hosteliers. OTA: RoomGroup/@SharedRoomInd.
  sharedRoom Boolean? @map("shared_room")

  /// Back-relation: RoomtypeGuestRoom records that reference this model via room_id.
  guestRooms RoomtypeGuestRoom[]

  /// GIN index: tag containment (@>) cannot use a B-tree.
  @@index([promotionVendorCodes], type: Gin)
  /// Maps the model to the "rooms" table in the database.
  @@map("rooms")
  /// Maps the model to the "roomtype" schema in the database.
  @@schema("roomtype")
}

