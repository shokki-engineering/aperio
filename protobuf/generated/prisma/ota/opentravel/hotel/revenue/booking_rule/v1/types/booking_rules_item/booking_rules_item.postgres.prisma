/// Information about an address that identifies a location for a specific purposes.
model BookingruleAddressInfo {
  /// Unique identifier for the record.
  id String @id(map: "bookingrule_address_infos_pkey") @default(ulid()) @map("id")

  /// Specifies if the associated data is formatted or not. When true, then it is formatted; when false, then not formatted. OTA: FormattedInd/@FormattedInd.
  formatted Boolean? @map("formatted")

  /// Permission for sharing data for synchronization of information held by other travel service providers. OTA: PrivacyGroup/@ShareSynchInd.
  shareSynchInd BookingRulesItemAcceptableGuaranteeGuaranteeAcceptedShareSynchInd? @map("share_synch_ind")

  /// Permission for sharing data for marketing purposes. OTA: PrivacyGroup/@ShareMarketInd.
  shareMarketInd BookingRulesItemAcceptableGuaranteeGuaranteeAcceptedShareMarketInd? @map("share_market_ind")

  /// Defines the type of address (e.g. home, business, other). Refer to OpenTravel Code List Communication Location Type (CLT). Codes from the OpenTravel code table CLT; each value's number is its OTA code. OTA: AddressType/@Type.
  type BookingruleCommunicationLocationType? @map("type")

  /// A remark associated with this address. OTA: AddressType/@Remark.
  remark String? @map("remark")

  /// Address language. Example: en OTA: AddressType/@Language.
  languageCode String? @map("language_code")

  /// Valid email address indicator. Example: true Implementer: If true, this is a valid and complete mailing address that has been verified through an address verification service or previously mailed materials have not been returned. OTA: AddressType/@ValidInd.
  valid Boolean? @map("valid")

  /// When true, indicates a default value should be used. OTA: DefaultIndGroup/@DefaultInd.
  defaultValue Boolean? @map("default_value")

  /// Describes the use of the address (e.g. mailing, delivery, billing, etc.). Refer to OpenTravel Code List Address Use Type (AUT). Codes from the OpenTravel code table AUT; each value's number is its OTA code. OTA: AddressInfoType/@UseType.
  useType BookingruleAddressUseType? @map("use_type")

  /// Used elsewhere in the message to reference this specific address. OTA: AddressInfoType/@RPH.
  rph String? @map("rph")

  /// When the address is unformatted (FormattedInd="false") these lines will contain free form address details. When the address is formatted and street number and street name must be sent independently, the street number will be sent using StreetNmbr, and the street name will be sent in the first AddressLine occurrence. OTA: AddressType/AddressLine.
  addressLines String[] @map("address_lines")

  /// City (e.g., Dublin), town, or postal station (i.e., a postal service territory, often used in a military address). OTA: AddressType/CityName.
  cityDisplayName String? @map("city_display_name")

  /// Post Office Code number. OTA: AddressType/PostalCode.
  postalCode String? @map("postal_code")

  /// County or Region Name (e.g., Fairfax). OTA: AddressType/County.
  county String? @map("county")

  /// Foreign key to StreetNmbr.
  streetNmbrID String? @map("street_nmbr_id")

  /// Relation to BookingruleStreetNmbr via street_nmbr_id.
  streetNmbr BookingruleStreetNmbr? @relation(fields: [streetNmbrID], references: [id], onDelete: SetNull, map: "bookingrule_address_infos_street_nmbr_id_fkey")

  /// Foreign key to StateProv.
  stateProvID String? @map("state_prov_id")

  /// Relation to BookingruleStateProv via state_prov_id.
  stateProv BookingruleStateProv? @relation(fields: [stateProvID], references: [id], onDelete: SetNull, map: "bookingrule_address_infos_state_prov_id_fkey")

  /// Foreign key to CountryName.
  countryDisplayNameID String? @map("country_display_name_id")

  /// Relation to BookingruleCountryName via country_display_name_id.
  countryDisplayName BookingruleCountryName? @relation(fields: [countryDisplayNameID], references: [id], onDelete: SetNull, map: "bookingrule_address_infos_country_display_name_id_fkey")

  /// Back-relation: BookingruleDirectBill records that reference this model via address_id.
  directBills BookingruleDirectBill[]

  /// Back-relation: BookingruleBldgRoom records that reference this model via address_info_id.
  bldgRooms BookingruleBldgRoom[]

  /// Index on [street_nmbr_id].
  @@index([streetNmbrID], map: "bookingrule_address_infos_street_nmbr_id_idx")
  /// Index on [state_prov_id].
  @@index([stateProvID], map: "bookingrule_address_infos_state_prov_id_idx")
  /// Index on [country_display_name_id].
  @@index([countryDisplayNameID], map: "bookingrule_address_infos_country_display_name_id_idx")
  /// GIN index: tag containment (@>) cannot use a B-tree.
  @@index([addressLines], type: Gin)
  /// Maps the model to the "address_infos" table in the database.
  @@map("address_infos")
  /// Maps the model to the "bookingrule" schema in the database.
  @@schema("bookingrule")
}

