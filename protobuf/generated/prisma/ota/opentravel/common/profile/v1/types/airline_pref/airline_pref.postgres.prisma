  id String @id @default(ulid()) @map("id")

  /// Type of tour (e.g., IT=inclusive Tour, BT= Bulk Tour, NR=Net Remit). OTA: AirlinePrefType/TourCodePref/TourCodeInfo/@TourTypeCode.
  tourTypeCode String? @map("tour_type_code")

  /// Last digit of the year of the tour code creation. OTA: AirlinePrefType/TourCodePref/TourCodeInfo/@YearNum.
  yearNum Int? @map("year_num")

  /// Promotion code is the identifier used by the host to link directly with a specific named advertising campaign. By including the required code, the client is able to gain access to special offers which may have been created for a specifically targeted group via a CRM system or for a wider advertising campaign using Television or press adverts. OTA: PromotionCodeGroup/@PromotionCode.
  promotionCode String? @map("promotion_code")

  /// List of the vendor codes associated with a promotion. OTA: PromotionCodeGroup/@PromotionVendorCode.
  promotionVendorCodes String[] @map("promotion_vendor_codes")

  /// Identifier assigned to a tour group by the airline. OTA: AirlinePrefType/TourCodePref/TourCodeInfo/@PartyID.
  partyID String? @map("party_id")

