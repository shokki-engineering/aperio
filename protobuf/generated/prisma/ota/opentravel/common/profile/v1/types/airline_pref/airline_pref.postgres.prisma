  tourCodePrefs TourCodePref[]

  /// GIN index: tag containment (@>) cannot use a B-tree.
  @@index([promotionVendorCodes], type: Gin)
  /// Maps the model to the "tour_code_infos" table in the database.
  @@map("tour_code_infos")
  /// Maps the model to the "profile" schema in the database.
  @@schema("profile")
}

