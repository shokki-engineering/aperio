  /// Confirmation status from the airline. Refer to OpenTravel code list Status (STS). Codes from the OpenTravel code table STS; each value's number is its OTA code. OTA: AirlinePrefType/KeywordPref/@StatusCode.
  statusCode StatusCode? @map("status_code")

  /// Number of passengers that will benefit from the request. OTA: AirlinePrefType/KeywordPref/@NumberInParty.
  partySize Int? @map("party_size")

  /// Airline vendor rph. OTA: AirlinePrefType/KeywordPref/@AirlineVendorRPH.
  airlineVendorRphs String[] @map("airline_vendor_rphs")

  /// Transfer action. OTA: AirlinePrefType/KeywordPref/@TransferAction.
  transferAction TransferAction? @map("transfer_action")

  /// Foreign key to AirlinePref.
  airlinePrefID String @map("airline_pref_id")

  /// Relation to AirlinePref via airline_pref_id.
  airlinePref AirlinePref @relation(fields: [airlinePrefID], references: [id], onDelete: Cascade)

  /// Index on [airline_pref_id].
  @@index([airlinePrefID])
  /// GIN index: tag containment (@>) cannot use a B-tree.
  @@index([airlineVendorRphs], type: Gin)
  /// Maps the model to the "keyword_prefs" table in the database.
  @@map("keyword_prefs")
  /// Maps the model to the "profile" schema in the database.
  @@schema("profile")
}

/// Provides the tour code.
model TourCodeInfo {
