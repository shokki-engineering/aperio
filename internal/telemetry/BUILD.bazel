load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "telemetry",
    srcs = [
        "config.go",
        "deployment.go",
        "fanout.go",
        "fanout_async.go",
        "fanout_sync.go",
        "meter.go",
        "prometheus.go",
        "registry.go",
        "telemetry.go",
    ],
    embedsrcs = ["telemetry.toml"],
    importpath = "github.com/shokki-engineering/aperio/internal/telemetry",
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_github_knadh_koanf_parsers_toml//:toml",
        "@com_github_knadh_koanf_providers_env_v2//:env",
        "@com_github_knadh_koanf_providers_rawbytes//:rawbytes",
        "@com_github_knadh_koanf_v2//:koanf",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/collectors",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@com_github_the_protobuf_project_runtime_go_observability//:observability",
        "@com_github_the_protobuf_project_runtime_go_telemetry//:telemetry",
        "@com_github_the_protobuf_project_telemetry_telemetry_go//:telemetry-go",
        "@com_github_the_protobuf_project_telemetry_telemetry_go//options",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_exporters_prometheus//:prometheus",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_metric//embedded",
        "@io_opentelemetry_go_otel_sdk//resource",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
    ],
)

go_test(
    name = "telemetry_test",
    srcs = [
        "fanout_test.go",
        "readers_test.go",
        "telemetry_test.go",
    ],
    embed = [":telemetry"],
    deps = [
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
    ],
)
